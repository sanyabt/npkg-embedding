{
    "dataset": "npkg",
    "model": "ComplEx",
    "emb_size": 400,
    "max_train_step": 2500,
    "batch_size": 512,
    "neg_sample_size": 128,
    "lr": 0.25,
    "gamma": 19.9,
    "double_ent": true,
    "double_rel": true,
    "neg_adversarial_sampling": true,
    "adversarial_temperature": 1.0,
    "regularization_coef": 1e-09,
    "regularization_norm": 3,
    "emap_file": "entities.tsv",
    "rmap_file": "relations.tsv"
}
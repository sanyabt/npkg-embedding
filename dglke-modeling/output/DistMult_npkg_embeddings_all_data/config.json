{
    "dataset": "npkg",
    "model": "DistMult",
    "emb_size": 400,
    "max_train_step": 5000,
    "batch_size": 512,
    "neg_sample_size": 128,
    "lr": 0.1,
    "gamma": 24.0,
    "double_ent": false,
    "double_rel": false,
    "neg_adversarial_sampling": true,
    "adversarial_temperature": 1.0,
    "regularization_coef": 2e-08,
    "regularization_norm": 3,
    "emap_file": "entities.tsv",
    "rmap_file": "relations.tsv"
}
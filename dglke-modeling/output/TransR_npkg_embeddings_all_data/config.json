{
    "dataset": "npkg",
    "model": "TransR",
    "emb_size": 100,
    "max_train_step": 2500,
    "batch_size": 512,
    "neg_sample_size": 128,
    "lr": 0.05,
    "gamma": 9.0,
    "double_ent": false,
    "double_rel": false,
    "neg_adversarial_sampling": true,
    "adversarial_temperature": 1.0,
    "regularization_coef": 2e-06,
    "regularization_norm": 3,
    "emap_file": "entities.tsv",
    "rmap_file": "relations.tsv"
}